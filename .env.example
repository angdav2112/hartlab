# Control-plane stub. Default is loopback — do not bind 0.0.0.0 until
# Phase 2 sits behind Caddy with real session lifecycle.
HARTLAB_BIND=127.0.0.1:8080
# Used when bollard starts real containers. Ignored by the current stub
# (it creates no sessions, so it cannot leak a counter).
HARTLAB_MAX_CONCURRENT=4
RUST_LOG=hartlab_control=info
